// MainWindow — sidebar + 2 view. Detail di ui/components/.
// Section label caps ala .tp-label versi lama. Empty-state bila list kosong.
import { ListView, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint"; // re-export agar bisa diakses dari Rust (window.global::<Theme>())
import { AppButton } from "components/app_button.slint";
import { AppCombo } from "components/app_combo.slint";
import { FileRow, FileRowItem } from "components/file_row.slint";
import { FileCellItem } from "components/file_cell.slint";
import { Crumb } from "components/crumb.slint";
import { SsRow, SsRowItem, SsHeader } from "components/ss_row.slint";
import { NavButton } from "components/nav_button.slint";
import { IconButton } from "components/icon_button.slint";
import { CheckRow } from "components/check_row.slint";
import { SearchField } from "components/search_field.slint";

export component MainWindow inherits Window {
    title: "FolderScope";
    icon: @image-url("../assets/icon.jpg");
    min-width: 900px;
    min-height: 600px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.bg-base;
    default-font-family: "Segoe UI";

    // Navigasi + tema
    in-out property <string> current-view: "explorer";
    in-out property <bool> is-light: false;
    in-out property <string> theme-label: "Gelap";

    // Explorer
    in-out property <string> target-folder: "";
    in-out property <string> status-text: "Pilih folder target untuk mulai.";
    in-out property <string> search-query: "";
    in-out property <bool> is-search-mode: false;
    in-out property <string> sort-mode: "Nama";
    in-out property <bool> opt-recursive: true;
    in-out property <bool> opt-case: false;
    in-out property <bool> opt-exact: false;
    in-out property <[FileRow]> results: [];
    in-out property <[string]> crumbs: [];
    in-out property <string> view-mode: "list"; // "list" | "grid"

    // Spreadsheet
    in-out property <string> ss-url: "";
    in-out property <string> ss-query: "";
    in-out property <string> ss-status-label: "Semua";
    in-out property <string> ss-status-text: "Masukkan URL API lalu klik Ambil Data.";
    in-out property <bool> ss-loading: false;
    in-out property <[SsRow]> ss-results: [];

    callback switch-view(string);
    callback toggle-theme();
    callback pick-folder();
    callback refresh();
    callback do-search();
    callback clear-search();
    callback sort-changed();
    callback open-file(int);
    callback reveal-file(int);
    callback enter-row(int);
    callback nav-crumb(int);
    callback ss-fetch();
    callback ss-apply-filter();

    HorizontalLayout {
        spacing: 0px;

        // ── Sidebar ──
        Rectangle {
            width: 78px;
            background: Theme.bg-surface;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 6px;
                alignment: start;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 11px;
                        background: Theme.accent;
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "FS";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.check-mark;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 6px; }
                NavButton {
                    label: "Explorer";
                    icon: @image-url("icons/folder.svg");
                    active: root.current-view == "explorer";
                    clicked => { root.switch-view("explorer"); }
                }
                NavButton {
                    label: "Sheet";
                    icon: @image-url("icons/grid.svg");
                    active: root.current-view == "spreadsheet";
                    clicked => { root.switch-view("spreadsheet"); }
                }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 1px;
                    horizontal-stretch: 1;
                    background: Theme.border;
                }
                NavButton {
                    label: root.is-light ? "Terang" : "Gelap";
                    icon: @image-url("icons/moon.svg");
                    icon-alt: @image-url("icons/sun.svg");
                    use-alt: root.is-light;
                    active: root.is-light;
                    clicked => { root.toggle-theme(); }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // ── Explorer view ──
        if root.current-view == "explorer": VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            padding: 14px;
            spacing: 8px;

            Text {
                text: "TARGET FOLDER";
                font-size: 10px;
                font-weight: 600;
                color: Theme.text-muted;
                letter-spacing: 0.6px;
            }
            Rectangle {
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        Image {
                            source: @image-url("icons/target.svg");
                            width: 26px;
                            height: 26px;
                            colorize: Theme.accent;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: root.target-folder == "" ? "Belum dipilih" : root.target-folder;
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            Text {
                                text: root.target-folder == "" ? "Pilih folder untuk mulai menjelajah" : "Folder target aktif";
                                font-size: 10px;
                                color: Theme.text-muted;
                                overflow: elide;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            text: "Pilih Folder";
                            primary: true;
                            horizontal-stretch: 1;
                            clicked => { root.pick-folder(); }
                        }
                        IconButton {
                            icon: @image-url("icons/refresh.svg");
                            tint: Theme.text-secondary;
                            clicked => { root.refresh(); }
                        }
                    }
                }
            }

            Text {
                text: "PENCARIAN";
                font-size: 10px;
                font-weight: 600;
                color: Theme.text-muted;
                letter-spacing: 0.6px;
            }
            // Debounce search explorer: tiap ketikan restart timer 350ms,
            // search jalan saat user berhenti mengetik (hemat walk disk).
            // Enter/tombol Cari tetap langsung (tanpa tunggu timer).
            search-debounce := Timer {
                interval: 350ms;
                triggered => {
                    self.stop();
                    root.do-search();
                }
            }
            HorizontalBox {
                spacing: 8px;
                SearchField {
                    text <=> root.search-query;
                    placeholder-text: "Cari nama file/folder… (otomatis)";
                    horizontal-stretch: 1;
                    accepted => { root.do-search(); }
                    edited(t) => { search-debounce.restart(); }
                }
                AppButton { text: "Cari"; primary: true; clicked => { root.do-search(); } }
                AppButton { text: "Reset"; clicked => { root.clear-search(); } }
            }
            HorizontalBox {
                spacing: 16px;
                CheckRow { label: "Recursive"; checked <=> root.opt-recursive; }
                CheckRow { label: "Case sensitive"; checked <=> root.opt-case; }
                CheckRow { label: "Exact match"; checked <=> root.opt-exact; }
            }

            HorizontalBox {
                spacing: 8px;
                Text {
                    text: root.status-text;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    text: "Urut:";
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                AppCombo {
                    model: ["Nama", "Tipe", "Ukuran", "Terbaru"];
                    current-value <=> root.sort-mode;
                    selected(v) => { root.sort-mode = v; root.sort-changed(); }
                }
            }

            // Breadcrumb posisi saat ini + toggle tampilan list/grid.
            // crumbs diisi Rust (target → current); klik crumb = naik ke level itu.
            if root.crumbs.length > 0: HorizontalBox {
                spacing: 6px;
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: start;
                        for c[i] in root.crumbs: HorizontalLayout {
                            spacing: 2px;
                            if i > 0: VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "›";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                            Crumb {
                                label: c;
                                active: i == root.crumbs.length - 1;
                                clicked => { root.nav-crumb(i); }
                            }
                        }
                    }
                }
                IconButton {
                    icon: @image-url("icons/list.svg");
                    tint: root.view-mode == "list" ? Theme.accent : Theme.text-muted;
                    clicked => { root.view-mode = "list"; }
                }
                IconButton {
                    icon: @image-url("icons/grid.svg");
                    tint: root.view-mode == "grid" ? Theme.accent : Theme.text-muted;
                    clicked => { root.view-mode = "grid"; }
                }
            }

            // Area konten utama: selalu stretch penuh agar window tidak mengecil
            Rectangle {
                vertical-stretch: 1;
                background: transparent;
                clip: true;

                if root.results.length == 0: Rectangle {
                    // empty-state tetap full-height
                    width: 100%;
                    height: 100%;
                    background: transparent;
                    VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 56px;
                                height: 56px;
                                border-radius: 28px;
                                background: Theme.accent-dim;
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: root.is-search-mode
                                                ? @image-url("icons/file.svg")
                                                : @image-url("icons/folder.svg");
                                            width: 28px;
                                            height: 28px;
                                            colorize: Theme.accent-light;
                                        }
                                    }
                                }
                            }
                        }
                        Text {
                            text: root.target-folder == ""
                                ? "Pilih folder target untuk mulai"
                                : root.is-search-mode
                                    ? "Tidak ditemukan hasil pencarian"
                                    : "Folder kosong";
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.target-folder == ""
                                ? "Klik tombol Pilih Folder di atas"
                                : root.is-search-mode
                                    ? "Coba kata kunci lain atau ubah opsi pencarian"
                                    : "Tidak ada file atau subfolder di sini";
                            font-size: 12px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                        }
                        if root.target-folder == "": HorizontalLayout {
                            alignment: center;
                            AppButton {
                                text: "Pilih Folder";
                                primary: true;
                                clicked => { root.pick-folder(); }
                            }
                        }
                    }
                }
                if root.results.length > 0 && root.view-mode == "list": ListView {
                    width: 100%;
                    height: 100%;
                    for row[idx] in root.results: FileRowItem {
                        row-name: row.name;
                        row-path: row.path;
                        row-info: row.info;
                        row-is-dir: row.is-dir;
                        row-index: idx;
                        row-kind: row.kind;
                        row-tint: row.tint;
                        open-clicked(i) => { root.open-file(i); }
                        reveal-clicked(i) => { root.reveal-file(i); }
                        row-clicked(i) => { root.enter-row(i); }
                    }
                }
                if root.results.length > 0 && root.view-mode == "grid": Flickable {
                    width: 100%;
                    height: 100%;
                    GridLayout {
                        width: 100%;
                        spacing: 10px;
                        for row[idx] in root.results: FileCellItem {
                            col: row.gcol;
                            row: row.grow;
                            cell-name: row.name;
                            cell-info: row.info;
                            cell-kind: row.kind;
                            cell-tint: row.tint;
                            cell-index: idx;
                            cell-clicked(i) => { root.enter-row(i); }
                            open-clicked(i) => { root.open-file(i); }
                            reveal-clicked(i) => { root.reveal-file(i); }
                        }
                    }
                }
            }
        }

        // ── Spreadsheet view ──
        if root.current-view == "spreadsheet": VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            padding: 14px;
            spacing: 8px;

            Text {
                text: "SUMBER DATA";
                font-size: 10px;
                font-weight: 600;
                color: Theme.text-muted;
                letter-spacing: 0.6px;
            }
            HorizontalBox {
                spacing: 8px;
                SearchField {
                    text <=> root.ss-url;
                    placeholder-text: "https://…/api… (JSON Array)";
                    horizontal-stretch: 1;
                    enabled: !root.ss-loading;
                    accepted => { root.ss-fetch(); }
                }
                AppButton {
                    has-icon: true;
                    icon: @image-url("icons/download.svg");
                    text: root.ss-loading ? "Memuat…" : "Ambil Data";
                    primary: true;
                    enabled: !root.ss-loading;
                    clicked => { root.ss-fetch(); }
                }
            }

            Text {
                text: "FILTER";
                font-size: 10px;
                font-weight: 600;
                color: Theme.text-muted;
                letter-spacing: 0.6px;
            }
            HorizontalBox {
                spacing: 8px;
                SearchField {
                    text <=> root.ss-query;
                    placeholder-text: "Cari NO / KODE / NAME…";
                    horizontal-stretch: 1;
                    edited(t) => { root.ss-apply-filter(); }
                }
                AppCombo {
                    model: ["Semua", "Lengkap", "Tidak Lengkap"];
                    current-value <=> root.ss-status-label;
                    selected(v) => { root.ss-status-label = v; root.ss-apply-filter(); }
                }
            }

            Text {
                text: root.ss-status-text;
                font-size: 11px;
                color: Theme.text-secondary;
                overflow: elide;
            }

            Rectangle {
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                vertical-stretch: 1;
                clip: true;
                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;
                    SsHeader { }
                    if root.ss-results.length == 0: Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 52px;
                                    height: 52px;
                                    border-radius: 26px;
                                    background: Theme.accent-dim;
                                    HorizontalLayout {
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("icons/grid.svg");
                                                width: 26px;
                                                height: 26px;
                                                colorize: Theme.accent-light;
                                            }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: "Belum ada data";
                                font-size: 14px;
                                font-weight: 500;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Masukkan URL API di atas lalu klik Ambil Data";
                                font-size: 12px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    if root.ss-results.length > 0: ListView {
                        vertical-stretch: 1;
                        for row[idx] in root.ss-results: SsRowItem {
                            c-no: row.c-no;
                            c-kode: row.c-kode;
                            c-name: row.c-name;
                            c-cat: row.c-cat;
                            c-uom: row.c-uom;
                            c-p: row.c-p;
                            c-l: row.c-l;
                            c-t: row.c-t;
                            c-b: row.c-b;
                            row-incomplete: row.row-incomplete;
                            warn-p: row.warn-p;
                            warn-l: row.warn-l;
                            warn-t: row.warn-t;
                            warn-b: row.warn-b;
                        }
                    }
                }
            }
        }
    }
}
