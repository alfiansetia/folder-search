// Tema global FolderScope (port variabel :root style.css versi lama).
// ATURAN: semua warna WAJIB ambil dari sini, jangan hardcode hex di komponen.
// Nilai diubah dari Rust via apply_theme() di src/main.rs. Lihat `.ai/UI.md`.
export global Theme {
    in-out property <color> bg-base: #0d0f14;
    in-out property <color> bg-surface: #141720;
    in-out property <color> bg-elevated: #1a1d27;
    in-out property <color> bg-hover: #1f2232;
    in-out property <color> accent: #6366f1;
    in-out property <color> accent-light: #818cf8;
    in-out property <color> accent-dim: #6366f126;
    in-out property <color> text-primary: #e8eaf6;
    in-out property <color> text-secondary: #8b91b0;
    in-out property <color> text-muted: #4e5270;
    in-out property <color> warn: #f87171;
    in-out property <color> warn-bg: #f8717120;
    in-out property <color> border: #ffffff0f;
    in-out property <length> radius: 10px;
    in-out property <length> radius-sm: 6px;
}
