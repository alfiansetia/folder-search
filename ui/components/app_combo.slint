// Dropdown bertema (pengganti ComboBox standar).
// Alasan: ComboBox fluent-dark tidak mengikuti Theme — teks tak terbaca
// dan popup tetap gelap di mode Terang. Komponen ini selalu pakai
// Theme.text-primary / Theme.bg-elevated sehingga terbaca di kedua mode.
// API disamakan dengan ComboBox: `model`, `current-value`, `selected()`.
import { Theme } from "../theme.slint";

export component AppCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <string> current-value;

    callback selected(string);

    height: 34px;
    min-width: 140px;
    background: Theme.bg-elevated;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: touch.has-hover || touch.pressed ? Theme.accent : Theme.border;
    clip: true;

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.bg-elevated;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                for opt in root.model: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: item-touch.has-hover ? Theme.bg-hover : (opt == root.current-value ? Theme.accent-dim : transparent);
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: opt;
                                font-size: 13px;
                                font-weight: opt == root.current-value ? 600 : 400;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-value = opt;
                            root.selected(opt);
                            popup.close();
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.current-value;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: "▾";
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
}
