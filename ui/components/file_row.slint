// Baris hasil file/folder — ikon tipe berwarna (port FILE_TYPES versi lama)
// + tombol aksi ikon + garis pemisah. Lihat `.ai/UI.md`.
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";

export struct FileRow {
    name: string,
    path: string,
    info: string,
    is_dir: bool,
    kind: string,
    tint: color,
}

export component FileRowItem inherits VerticalLayout {
    in property <string> row-name;
    in property <string> row-path;
    in property <string> row-info;
    in property <bool> row-is-dir;
    in property <int> row-index;
    in property <string> row-kind;
    in property <color> row-tint;

    callback open-clicked(int);
    callback reveal-clicked(int);

    spacing: 0px;
    padding: 0px;

    HorizontalLayout {
        spacing: 10px;
        padding-top: 5px;
        padding-bottom: 5px;
        padding-left: 6px;
        padding-right: 6px;

        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            Rectangle {
                border-radius: 8px;
                background: row-tint;
                opacity: 0.15;
            }
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    if row-kind == "folder": Image { source: @image-url("../icons/folder.svg"); width: 20px; height: 20px; colorize: row-tint; }
                    if row-kind == "image": Image { source: @image-url("../icons/image.svg"); width: 20px; height: 20px; colorize: row-tint; }
                    if row-kind == "video": Image { source: @image-url("../icons/video.svg"); width: 20px; height: 20px; colorize: row-tint; }
                    if row-kind == "audio": Image { source: @image-url("../icons/audio.svg"); width: 20px; height: 20px; colorize: row-tint; }
                    if row-kind == "doc": Image { source: @image-url("../icons/doc.svg"); width: 20px; height: 20px; colorize: row-tint; }
                    if row-kind == "code": Image { source: @image-url("../icons/code.svg"); width: 20px; height: 20px; colorize: row-tint; }
                    if row-kind == "archive": Image { source: @image-url("../icons/archive.svg"); width: 20px; height: 20px; colorize: row-tint; }
                    if row-kind == "exe": Image { source: @image-url("../icons/exe.svg"); width: 20px; height: 20px; colorize: row-tint; }
                    if row-kind == "font": Image { source: @image-url("../icons/font.svg"); width: 20px; height: 20px; colorize: row-tint; }
                    if row-kind == "file": Image { source: @image-url("../icons/file.svg"); width: 20px; height: 20px; colorize: row-tint; }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;
            Text {
                text: row-name;
                font-size: 13px;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                text: row-path;
                font-size: 10px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                Text {
                    text: row-info;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: @image-url("../icons/external.svg");
                    clicked => { root.open-clicked(root.row-index); }
                }
                IconButton {
                    icon: @image-url("../icons/eye.svg");
                    clicked => { root.reveal-clicked(root.row-index); }
                }
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.border;
    }
}
