// Baris hasil file/folder — ikon tipe berwarna (port FILE_TYPES versi lama)
// + tombol aksi ikon + garis pemisah. Lihat `.ai/UI.md`.
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";
import { FileTypeIcon } from "file_icon.slint";

export struct FileRow {
    name: string,
    path: string,
    info: string,
    is_dir: bool,
    kind: string,
    tint: color,
    gcol: int,
    grow: int,
}

export component FileRowItem inherits Rectangle {
    in property <string> row-name;
    in property <string> row-path;
    in property <string> row-info;
    in property <bool> row-is-dir;
    in property <int> row-index;
    in property <string> row-kind;
    in property <color> row-tint;

    callback open-clicked(int);
    callback reveal-clicked(int);
    callback row-clicked(int);

    background: touch.has-hover ? Theme.bg-hover : transparent;
    border-radius: Theme.radius-sm;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.row-clicked(root.row-index); }
    }

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        HorizontalLayout {
            spacing: 10px;
            padding-top: 5px;
            padding-bottom: 5px;
            padding-left: 6px;
            padding-right: 6px;

            FileTypeIcon {
                kind: root.row-kind;
                tint: root.row-tint;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 1px;
                alignment: center;
                Text {
                    text: row-name;
                    font-size: 13px;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: row-path;
                    font-size: 10px;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 2px;
                    Text {
                        text: row-info;
                        font-size: 11px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    IconButton {
                        icon: @image-url("../icons/external.svg");
                        clicked => { root.open-clicked(root.row-index); }
                    }
                    IconButton {
                        icon: @image-url("../icons/eye.svg");
                        clicked => { root.reveal-clicked(root.row-index); }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }
    }
}
